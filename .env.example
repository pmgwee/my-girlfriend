# Copy to .env and edit. Every value has a working default in server/app/config.py.

# ---------------- server ----------------
HOST=127.0.0.1
PORT=8765
LOG_LEVEL=INFO

# ---------------- VAD ----------------
# Useful range 0.35-0.45. Lower if she doesn't react to you at all; raise if
# room noise keeps triggering turns.
VAD_THRESHOLD=0.4
# Trailing silence that ends your turn. Lower = snappier, more likely to cut you off.
VAD_SILENCE_MS=500
VAD_MIN_SPEECH_MS=300
VAD_PREFIX_MS=320

# ---------------- STT ----------------
# Measured on CPU, Mandarin: tiny 356ms/71%, base 671ms/87%, small 2039ms/89%.
# Whisper pads every clip to a 30s window, so this cost is flat regardless of
# how briefly you spoke -- model size dominates.
STT_MODEL=base
# cpu | cuda. CPU is the safe default on a 6GB card; see README.
STT_DEVICE=cpu
# int8 on CPU, int8_float16 on cuda.
STT_COMPUTE_TYPE=int8
# zh, en, or blank to auto-detect (costs ~100ms per turn).
STT_LANGUAGE=zh

# ---------------- LLM ----------------
# LOCAL (default). Port 18080, not 8080/8090 -- those collide with Apache,
# Jenkins, Tomcat and Windows' notification helper on many machines.
LLM_BASE_URL=http://127.0.0.1:18080/v1
LLM_MODEL=local
LLM_API_KEY=no-key-needed

# HOSTED -- required if you run Qwen3-TTS 1.7B, which needs the whole GPU.
# Any OpenAI-compatible endpoint works. Stop llama-server first to free VRAM.
# Good picks for Mandarin, cheap and low-latency from Asia:
#
#   DeepSeek     LLM_BASE_URL=https://api.deepseek.com/v1
#                LLM_MODEL=deepseek-chat
#   Qwen/DashScope  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#                LLM_MODEL=qwen-plus
#   Moonshot     LLM_BASE_URL=https://api.moonshot.cn/v1
#                LLM_MODEL=moonshot-v1-8k
#   OpenAI       LLM_BASE_URL=https://api.openai.com/v1
#                LLM_MODEL=gpt-4o-mini
#
# Only the TEXT of your messages leaves the machine -- audio is still
# transcribed locally by Whisper and spoken locally by Qwen3-TTS.
LLM_TEMPERATURE=0.85
LLM_MAX_TOKENS=320
LLM_HISTORY_TURNS=12

# ---------------- TTS ----------------
# qwen3  = clone a voice from your own reference clip (needs torch+CUDA)
# kokoro = fixed Chinese voice bank, CPU only, no cloning
# qwentts | piper = see README
TTS_BACKEND=kokoro

# --- voice cloning (TTS_BACKEND=qwen3) ---
# 0.6B: ~2.0GB VRAM, fits beside a 4B LLM on a 6GB card.
# 1.7B: ~4.2GB VRAM, better voice, but the LLM must move off the GPU.
QWEN3_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
QWEN3_REF_AUDIO=voices/reference.wav
# EXACT transcript of the reference clip. Cloning degrades badly if wrong.
QWEN3_REF_TEXT=
QWEN3_DEVICE=cuda
QWEN3_DTYPE=bfloat16
# Kokoro v1.1-zh: zf_001..zf_099 (female), zm_009..zm_100 (male).
TTS_VOICE=zf_001
TTS_SPEED=1.0
QWENTTS_BASE_URL=http://127.0.0.1:8081
